# Workout reminders (optional). Without these the app works fully; only reminders are off.
# Full steps: docs/REMINDERS_SETUP.md

# Generate once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact the push services can reach if your push traffic misbehaves. "mailto:you@example.com".
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret the scheduler (cron-job.org) sends in the x-cron-secret header.
# Required: without it the send endpoint refuses everyone.  Generate:  openssl rand -hex 32
PUSH_CRON_SECRET=""

# Where subscriptions are kept: Upstash Redis. In Vercel: Storage > Create Database >
# Upstash for Redis > connect to this project, and these two are added for you.
# (Vercel's older KV product injects KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.)
# Keys are prefixed "intervo:", so this can be the same database another app already uses.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
